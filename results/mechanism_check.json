  "accepted_code": "from qiskit import QuantumRegister, ClassicalRegister, QuantumCircuit\n\n\ndef GHZ3_SWAPTEST() -> QuantumCircuit:\n    \"\"\"Perform three independent pairwise SWAP tests on fresh state copies.\"\"\"\n    ancilla = QuantumRegister(3, \"ancilla\")\n    ghz_registers = [QuantumRegister(3, f\"ghz_{i}\") for i in range(3)]\n    plus_registers = [QuantumRegister(3, f\"plus_{i}\") for i in range(3)]\n    result = ClassicalRegister(3, \"result\")\n    circuit = QuantumCircuit(ancilla, *ghz_registers, *plus_registers, result)\n\n    for i in range(3):\n        ghz = ghz_registers[i]\n        plus = plus_registers[i]\n        circuit.h(ghz[0])\n        circuit.cx(ghz[0], ghz[1])\n        circuit.cx(ghz[0], ghz[2])\n        circuit.h(plus)\n\n        circuit.h(ancilla[i])\n        circuit.cswap(ancilla[i], ghz[i], plus[i])\n        circuit.h(ancilla[i])\n\n    circuit.measure(ancilla, result)\n    return circuit\n",
